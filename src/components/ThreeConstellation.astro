---
// Receives posts as a JSON-serialized data attribute on the host element.
// Render is gated by JS — without JS, the page still falls back to "The Written Archive" list below.
interface Props {
  posts: Array<{ slug: string; title: string; tags: string[]; primaryCategory?: string; pubDate: string; }>;
}
const { posts } = Astro.props;
const postsJson = JSON.stringify(posts);
---

<div class="constellation-stage" data-posts={postsJson}>
  <div class="constellation-frame">

    <div id="constellation-canvas-host" class="constellation-canvas-host"></div>

    <!-- Cinematic vignette drives the deep-space feel -->
    <div class="constellation-vignette" aria-hidden="true"></div>

    <!-- Top bar: live status + reset -->
    <div class="constellation-topbar">
      <div class="constellation-status">
        <span class="status-eyebrow">LIVE FEED</span>
        <span class="status-clock"><span class="status-dot"></span><span id="constellation-clock">—</span></span>
      </div>
      <button id="constellation-reset" class="constellation-btn" type="button" aria-label="Reset view">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 1 0 3-6.7L3 8"/>
          <polyline points="3 3 3 8 8 8"/>
        </svg>
        <span>Reset</span>
      </button>
    </div>

    <!-- Floating 3D-projected cluster labels -->
    <div id="constellation-labels" class="constellation-labels" aria-hidden="true"></div>

    <!-- Hover tooltip (article preview) -->
    <div id="constellation-tooltip" class="constellation-tooltip" aria-hidden="true"></div>

    <!-- Side legend: always-on, accessible clickable list of topics -->
    <aside id="constellation-legend" class="constellation-legend" aria-label="Topics"></aside>

    <!-- Bottom HUD: count + hint -->
    <div class="constellation-hud">
      <span id="constellation-count" class="hud-count">—</span>
      <span class="hud-hint">drag · scroll · click</span>
    </div>

    <!-- Onboarding overlay (first visit only) -->
    <div id="constellation-overlay" class="constellation-overlay" role="dialog" aria-modal="false" aria-labelledby="overlay-title">
      <div class="overlay-copy">
        <span class="overlay-eyebrow">EXPLORE THE UNIVERSE</span>
        <h2 id="overlay-title" class="overlay-title">A Constellation of Ideas</h2>
        <p class="overlay-desc">Drag to rotate · Scroll to zoom · Click any star to read.<br/>Hover a cluster to dim the others.</p>
        <button id="constellation-enter" class="overlay-btn" type="button">Enter the Universe</button>
      </div>
    </div>

  </div>
</div>

<script is:inline src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof THREE === 'undefined') return;

    const stage    = document.querySelector('.constellation-stage');
    const host     = document.getElementById('constellation-canvas-host');
    const labels   = document.getElementById('constellation-labels');
    const tooltip  = document.getElementById('constellation-tooltip');
    const overlay  = document.getElementById('constellation-overlay');
    const enterBtn = document.getElementById('constellation-enter');
    const hudCount = document.getElementById('constellation-count');
    const hudLegend= document.getElementById('constellation-legend');
    const clockEl  = document.getElementById('constellation-clock');
    const resetBtn = document.getElementById('constellation-reset');
    if (!host || !stage || !labels) return;

    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    if (isMobile) { stage.style.display = 'none'; return; }

    // === 1. Parsed posts → top-10 buckets with proper {name, count, items} shape ===
    let posts = [];
    try { posts = JSON.parse(stage.dataset.posts || '[]'); } catch { posts = []; }
    if (!posts.length) { stage.style.display = 'none'; return; }

    const tagBuckets = new Map();
    for (const p of posts) {
      const t = (p.primaryCategory || (p.tags && p.tags[0]) || 'essay').toString().toLowerCase().trim();
      if (!tagBuckets.has(t)) tagBuckets.set(t, []);
      tagBuckets.get(t).push(p);
    }
    const clusterMeta = [...tagBuckets.entries()]
      .sort((a, b) => b[1].length - a[1].length)
      .slice(0, 10)
      .map(([name, items]) => ({ name, count: items.length, items }));

    // Pretty-name for display: 'ai-economics' -> 'AI Economics'
    const pretty = (s) => (s || 'essay')
      .toString()
      .replace(/[-_]+/g, ' ')
      .split(' ')
      .map(w => w.length <= 2 && w.toLowerCase() === 'ai' ? 'AI'
              : w.length <= 3 && w.toLowerCase() === 'llm' ? 'LLM'
              : w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');

    // === 2. Color palette: 10 cosmic-distinct clusters ===
    const COLORS = [
      0x8b5cf6, 0x2dd4bf, 0x60a5fa, 0xfb923c, 0xf472b6,
      0x4ade80, 0xfacc15, 0x22d3ee, 0xc084fc, 0xfb7185,
    ];

    // === 3. Scene + camera + renderer ===
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x050510);
    scene.fog = new THREE.FogExp2(0x050510, 0.008);

    const camera = new THREE.PerspectiveCamera(58, host.clientWidth / host.clientHeight, 0.1, 1200);
    camera.position.set(0, 42, 145); // start far — opening fly-in brings it down

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(host.clientWidth, host.clientHeight);
    host.appendChild(renderer.domElement);

    // === 4. Three-layer starfield for cosmic depth ===
    function makeStarLayer(count, rMin, rMax, size, colorIntensity) {
      const geo = new THREE.BufferGeometry();
      const pos = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);
      const tmp = new THREE.Color();
      for (let i = 0; i < count; i++) {
        const r = rMin + Math.random() * (rMax - rMin);
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos(2 * Math.random() - 1);
        pos[i*3]   = r * Math.sin(phi) * Math.cos(theta);
        pos[i*3+1] = r * Math.sin(phi) * Math.sin(theta);
        pos[i*3+2] = r * Math.cos(phi);
        tmp.setHex(COLORS[Math.floor(Math.random() * COLORS.length)]);
        const k = colorIntensity[0] + Math.random() * (colorIntensity[1] - colorIntensity[0]);
        col[i*3]   = tmp.r * k;
        col[i*3+1] = tmp.g * k;
        col[i*3+2] = tmp.b * k;
      }
      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      geo.setAttribute('color',    new THREE.BufferAttribute(col, 3));
      const mat = new THREE.PointsMaterial({
        size, vertexColors: true, transparent: true,
        opacity: 0.95, sizeAttenuation: true, depthWrite: false,
      });
      return new THREE.Points(geo, mat);
    }

    const farStars  = makeStarLayer(2000, 180, 320, 0.45, [0.25, 0.7]);
    const midStars  = makeStarLayer(450, 90, 140, 0.95, [0.6,  1.0]);
    const dust      = makeStarLayer(650, 40, 120, 0.18, [0.3,  0.7]);
    scene.add(farStars, midStars, dust);

    // === 5. Cluster placement (transformed Fibonacci sphere) ===
    const fibonacci = (n, i) => {
      const phi   = Math.acos(1 - 2 * (i + 0.5) / n);
      const theta = Math.PI * (1 + Math.sqrt(5)) * i;
      return new THREE.Vector3(
        Math.sin(phi) * Math.cos(theta),
        Math.cos(phi) * 0.55, // vertical squash gives "horizon" feel
        Math.sin(phi) * Math.sin(theta),
      );
    };
    const CLUSTER_RADIUS = 42;

    const clusters = []; // animation-loop state
    clusterMeta.forEach((bucket, idx) => {
      const color = COLORS[idx % COLORS.length];
      const center = fibonacci(clusterMeta.length, idx).multiplyScalar(CLUSTER_RADIUS);
      const group = new THREE.Group();
      group.position.copy(center);
      scene.add(group);

      // 5a. Bright central core
      const core = new THREE.Mesh(
        new THREE.SphereGeometry(1.1, 24, 18),
        new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.95, depthWrite: false }),
      );
      group.add(core);

      // 5b. Wireframe halo (gives cluster its volume sign)
      const haloR = 3.6 + Math.min(8, bucket.count * 0.32);
      const halo = new THREE.Mesh(
        new THREE.IcosahedronGeometry(haloR, 1),
        new THREE.MeshBasicMaterial({ color, wireframe: true, transparent: true, opacity: 0.22 }),
      );
      group.add(halo);

      // 5c. Atmospheric outer glow (back-side sphere)
      const glow = new THREE.Mesh(
        new THREE.SphereGeometry(haloR * 1.7, 28, 22),
        new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.06, side: THREE.BackSide, depthWrite: false }),
      );
      group.add(glow);

      // 5d. Cluster motes (dust drifting inside)
      const moteCount = 36;
      const motePos = new Float32Array(moteCount * 3);
      const moteCol = new Float32Array(moteCount * 3);
      const c = new THREE.Color(color);
      for (let m = 0; m < moteCount; m++) {
        const r = 1.6 + Math.random() * haloR * 1.05;
        const theta = Math.random() * Math.PI * 2;
        const phi   = Math.acos(2 * Math.random() - 1);
        motePos[m*3]   = r * Math.sin(phi) * Math.cos(theta);
        motePos[m*3+1] = r * Math.cos(phi) * 0.85;
        motePos[m*3+2] = r * Math.sin(phi) * Math.sin(theta);
        moteCol[m*3]   = c.r;
        moteCol[m*3+1] = c.g;
        moteCol[m*3+2] = c.b;
      }
      const moteGeo = new THREE.BufferGeometry();
      moteGeo.setAttribute('position', new THREE.BufferAttribute(motePos, 3));
      moteGeo.setAttribute('color',    new THREE.BufferAttribute(moteCol, 3));
      const motes = new THREE.Points(moteGeo, new THREE.PointsMaterial({
        size: 0.32, vertexColors: true, transparent: true, opacity: 0.7,
        sizeAttenuation: true, depthWrite: false,
      }));
      group.add(motes);

      clusters.push({
        idx, name: pretty(bucket.name), raw: bucket.name,
        count: bucket.count, color, colorHex: '#' + color.toString(16).padStart(6, '0'),
        items: bucket.items, center, group, core, halo, glow, motes, haloR, moteGeo,
      });
    });

    // === 6. Posts: bright stars within each cluster ===
    const postNodes = [];
    clusterMeta.forEach((bucket, idx) => {
      const C = clusters[idx];
      bucket.items.forEach((post, j) => {
        const u = Math.random();
        const v = Math.random();
        const theta = 2 * Math.PI * u;
        const phi   = Math.acos(2 * v - 1);
        const r = C.haloR * (0.75 + Math.random() * 0.55);
        const offset = new THREE.Vector3(
          r * Math.sin(phi) * Math.cos(theta),
          r * Math.cos(phi) * 0.7,
          r * Math.sin(phi) * Math.sin(theta),
        );
        const pos = C.center.clone().add(offset);
        // newer posts (smaller j) get a slight size bonus
        const novelty = 1 - (j / Math.max(1, bucket.items.length - 1));
        const size = 0.55 + novelty * 0.5;

        const sphere = new THREE.Mesh(
          new THREE.SphereGeometry(size, 14, 10),
          new THREE.MeshBasicMaterial({ color: C.color, transparent: true, opacity: 0.95, depthWrite: false }),
        );
        sphere.position.copy(pos);
        scene.add(sphere);

        const halo = new THREE.Mesh(
          new THREE.SphereGeometry(size * 2.6, 12, 8),
          new THREE.MeshBasicMaterial({ color: C.color, transparent: true, opacity: 0.18, depthWrite: false }),
        );
        halo.position.copy(pos);
        scene.add(halo);

        const node = {
          post, clusterIdx: idx, cluster: C, pos: pos.clone(),
          size, novelty, sphere, halo,
        };
        sphere.userData.node = node;
        postNodes.push(node);
      });
    });

    // === 7. Camera state + damping ===
    const camState = {
      theta: Math.atan2(camera.position.x, camera.position.z),
      phi:   Math.asin(camera.position.y / camera.position.length()),
      radius: camera.position.length(),

      targetTheta: Math.atan2(camera.position.x, camera.position.z),
      targetPhi:   Math.asin(camera.position.y / camera.position.length()),
      targetRadius: 80,

      isFlying: false,
      flyStart: 0,
      flyDur: 2400,
      flyFrom: { theta: 0, phi: 0, radius: 0 },
      flyTo:   { theta: 0.55, phi: 0.46, radius: 80 }, // gentle overview
      opRadius: 80,
      opTheta: 0.55,
      opPhi: 0.46,

      lastInteract: 0,
    };
    const PAN_LIMIT = Math.PI / 2 - 0.18;

    function updateCamera() {
      camState.theta  += (camState.targetTheta  - camState.theta)  * 0.085;
      camState.phi    += (camState.targetPhi    - camState.phi)    * 0.085;
      camState.radius += (camState.targetRadius - camState.radius) * 0.085;
      const r = camState.radius;
      const sinPhi = Math.sin(camState.phi);
      camera.position.set(
        r * sinPhi * Math.cos(camState.theta),
        r * Math.cos(camState.phi),
        r * sinPhi * Math.sin(camState.theta),
      );
      camera.lookAt(0, 0, 0);
    }

    function stepOpeningFly() {
      if (!camState.isFlying) return;
      const t = Math.min(1, (performance.now() - camState.flyStart) / camState.flyDur);
      const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      camState.targetTheta  = camState.flyFrom.theta  + (camState.flyTo.theta  - camState.flyFrom.theta)  * e;
      camState.targetPhi    = camState.flyFrom.phi    + (camState.flyTo.phi    - camState.flyFrom.phi)    * e;
      camState.targetRadius = camState.flyFrom.radius + (camState.flyTo.radius - camState.flyFrom.radius) * e;
      if (t >= 1) camState.isFlying = false;
    }

    function flyToCluster(idx) {
      const C = clusters[idx];
      const startT = camState.targetTheta;
      const startP = camState.targetPhi;
      const startR = camState.targetRadius;
      const wantTheta = Math.atan2(C.center.x, C.center.z);
      const wantR = Math.max(20, C.haloR * 5 + 14);
      const wantPhi = Math.asin(C.center.y / Math.max(0.001, C.center.length()));
      const start = performance.now();
      const dur = 1300;
      function step() {
        const t = Math.min(1, (performance.now() - start) / dur);
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        camState.targetTheta  = startT + (wantTheta - startT) * e;
        camState.targetPhi    = startP + (wantPhi   - startP) * e;
        camState.targetRadius = startR + (wantR     - startR) * e;
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
      camState.lastInteract = performance.now();
    }

    function resetView() {
      camState.targetTheta  = camState.opTheta;
      camState.targetPhi    = camState.opPhi;
      camState.targetRadius = camState.opRadius;
      camState.lastInteract = performance.now();
    }

    // === 8. Floating cluster labels (3D-projected) ===
    clusters.forEach((C, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'constellation-label';
      btn.dataset.idx = String(i);
      btn.setAttribute('aria-label', `${C.name} — ${C.count} essays`);
      btn.innerHTML =
        `<span class="label-dot" style="background:${C.colorHex}; box-shadow:0 0 12px ${C.colorHex}"></span>` +
        `<span class="label-name">${C.name}</span>` +
        `<span class="label-count">${C.count}</span>`;
      labels.appendChild(btn);

      btn.addEventListener('mouseenter', () => focusCluster(i, true));
      btn.addEventListener('mouseleave', () => focusCluster(-1, false));
      btn.addEventListener('click',      () => flyToCluster(i));
    });

    // === 9. Side legend pills (always-on, clickable) ===
    hudLegend.innerHTML = clusters.map((C, i) =>
      `<button type="button" class="legend-pill" data-idx="${i}" style="--c:${C.colorHex}">` +
        `<span class="legend-dot" style="background:${C.colorHex}"></span>` +
        `<span class="legend-name">${C.name}</span>` +
        `<span class="legend-count">${C.count}</span>` +
      `</button>`
    ).join('');
    hudLegend.querySelectorAll('.legend-pill').forEach(btn => {
      const i = parseInt(btn.dataset.idx, 10);
      btn.addEventListener('mouseenter', () => focusCluster(i, true));
      btn.addEventListener('mouseleave', () => focusCluster(-1, false));
      btn.addEventListener('click', () => flyToCluster(i));
    });

    hudCount.textContent = `${posts.length} nodes · ${clusters.length} clusters`;

    // === 10. Focus / dim state ===
    let focused = -1;
    // Cluster focus only writes CLUSTER state immediately (gives instant feedback on hover).
    // POST opacity is owned by the animate() loop below as the single source of truth,
    // so this function does not touch postNodes — avoids the brittle threshold logic.
    function focusCluster(idx, hover) {
      if (hover) focused = idx; else focused = -1;
      const isOn = focused !== -1;
      for (const C of clusters) {
        const onThis = (C.idx === focused);
        const haloOp = isOn ? (onThis ? 0.55 : 0.06) : 0.22;
        const glowOp = isOn ? (onThis ? 0.14 : 0.015) : 0.05;
        const coreOp = isOn ? (onThis ? 1.0  : 0.35) : 0.95;
        C.halo.material.opacity = haloOp;
        C.glow.material.opacity = glowOp;
        C.core.material.opacity = coreOp;
      }
    }

    // === 11. Pointer / drag / wheel ===
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2(-10, -10);
    let hovered = null;
    let isDragging = false;
    let dragStart = { x: 0, y: 0 };
    let dragMoved = false;

    function onPointerDown(e) {
      isDragging = true;
      dragMoved = false;
      dragStart.x = e.clientX;
      dragStart.y = e.clientY;
      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup',   onPointerUp);
      camState.lastInteract = performance.now();
      renderer.domElement.style.cursor = 'grabbing';
    }
    function onPointerMove(e) {
      const dx = e.clientX - dragStart.x;
      const dy = e.clientY - dragStart.y;
      if (Math.hypot(e.clientX - dragStart.x, e.clientY - dragStart.y) > 4) dragMoved = true;
      if (dragMoved) {
        camState.targetTheta -= dx * 0.005;
        camState.targetPhi = Math.max(-PAN_LIMIT, Math.min(PAN_LIMIT, camState.targetPhi + dy * 0.005));
        dragStart.x = e.clientX;
        dragStart.y = e.clientY;
        pointer.x = -10; pointer.y = -10;
        tooltip.classList.remove('visible');
        camState.lastInteract = performance.now();
      } else {
        const rect = renderer.domElement.getBoundingClientRect();
        pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      }
      // Hide post hover during drag
      if (hovered) {
        hovered = null;
        tooltip.classList.remove('visible');
        renderer.domElement.style.cursor = 'grabbing';
      }
    }
    function onPointerUp() {
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup',   onPointerUp);
      isDragging = false;
      renderer.domElement.style.cursor = 'grab';
      if (!dragMoved && hovered) {
        window.location.href = `/blog/${hovered.post.slug}`;
      }
      camState.lastInteract = performance.now();
    }
    renderer.domElement.addEventListener('pointerdown', onPointerDown);

    function onWheel(e) {
      e.preventDefault();
      camState.targetRadius = Math.max(22, Math.min(180, camState.targetRadius + e.deltaY * 0.04));
      camState.lastInteract = performance.now();
    }
    renderer.domElement.addEventListener('wheel', onWheel, { passive: false });

    function onResize() {
      const w = host.clientWidth, h = host.clientHeight;
      if (w === 0 || h === 0) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    }
    window.addEventListener('resize', onResize);
    // ResizeObserver so layout changes (font-load, etc.) also fix the canvas
    // ResizeObserver stored in component scope so cleanup can disconnect it.
    // (Decoupling the observer from any closure is the correct hygiene.)
    let ro = null;
    if (typeof ResizeObserver !== 'undefined') {
      ro = new ResizeObserver(onResize);
      ro.observe(host);
    }

    if (resetBtn) resetBtn.addEventListener('click', resetView);
    // NOTE: enterBtn listener is NOT registered here unconditionally.
    // It's only registered in the first-visit branch below with `{ once: true }`,
    // so that returning visitors (or already-dismissed overlays) never double-fire.

    // Onboarding: first visit shows overlay; subsequent visits silently fly in
    function triggerOpeningFly() {
      camState.flyFrom.theta  = camState.targetTheta;
      camState.flyFrom.phi    = camState.targetPhi;
      camState.flyFrom.radius = camState.targetRadius;
      camState.flyStart = performance.now();
      camState.isFlying = true;
    }
    if (overlay && !sessionStorage.getItem('constellationSeen')) {
      overlay.classList.add('visible');
      sessionStorage.setItem('constellationSeen', '1');
      if (enterBtn) {
        enterBtn.addEventListener('click', () => {
          overlay.classList.add('dismissed');
          resetView();
          triggerOpeningFly();
        }, { once: true });
      }
    } else if (overlay) {
      overlay.classList.add('dismissed');
      // Defer to next frame so layout settles
      requestAnimationFrame(triggerOpeningFly);
    }

    // === 12. Live status clock ===
    function tickClock() {
      if (!clockEl) return;
      const d = new Date();
      const hh = String(d.getHours()).padStart(2, '0');
      const mm = String(d.getMinutes()).padStart(2, '0');
      const ss = String(d.getSeconds()).padStart(2, '0');
      clockEl.textContent = `${hh}:${mm}:${ss} · live`;
    }
    tickClock();
    setInterval(tickClock, 1000);

    // === 13. Animation loop ===
    const clock = new THREE.Clock();
    let animId;

    const stageRect = () => stage.getBoundingClientRect();

    const tmpV = new THREE.Vector3();

    function animate() {
      animId = requestAnimationFrame(animate);
      const elapsed = clock.getElapsedTime();

      stepOpeningFly();

      // Subtle auto-orbit when idle (>3.5s) AND not flying
      const idleMs = performance.now() - camState.lastInteract;
      if (!camState.isFlying && idleMs > 3500 && idleMs < 60000) {
        camState.targetTheta += 0.0007;
      }

      // Background depth layers drift at different speeds
      farStars.rotation.y = elapsed * 0.006;
      farStars.rotation.x = Math.sin(elapsed * 0.04) * 0.04;
      midStars.rotation.y = elapsed * 0.011;
      midStars.rotation.x = Math.cos(elapsed * 0.03) * 0.06;
      dust.rotation.y     = -elapsed * 0.005;
      dust.rotation.x     =  Math.sin(elapsed * 0.025) * 0.03;

      // Cluster slow rotation + breathing
      for (let i = 0; i < clusters.length; i++) {
        const C = clusters[i];
        const sign = (i % 2) ? 1 : -1;
        C.group.rotation.y = elapsed * 0.045 * sign * 0.6;
        C.group.rotation.x = Math.sin(elapsed * 0.4 + i) * 0.12;
        C.halo.rotation.y  = elapsed * 0.08 * sign;
        C.halo.rotation.x  = elapsed * 0.04;
        const pulse = 1 + Math.sin(elapsed * 1.4 + i * 0.7) * 0.08;
        C.core.scale.setScalar(pulse);
        C.motes.rotation.y = elapsed * 0.02 * sign;
      }

      // Post pulse + halo + opacity (single source of truth per frame)
      for (let i = 0; i < postNodes.length; i++) {
        const n = postNodes[i];
        const rate = 1.2 + (i % 7) * 0.13;
        const amp  = 0.05 + n.novelty * 0.10;
        const isHover      = (hovered === n);
        const isFocusedHere = (focused === n.clusterIdx);
        const isDimmedHere  = (focused !== -1 && !isFocusedHere);
        const pulse = isHover ? 1.85 : (1 + Math.sin(elapsed * rate + i) * amp);
        n.sphere.scale.setScalar(pulse);
        n.halo.scale.setScalar(1 + (pulse - 1) * 0.4);

        n.sphere.material.opacity = isHover ? 1.0 : isDimmedHere ? 0.15 : 0.95;
        n.halo.material.opacity   = isHover ? 0.55 : isDimmedHere ? 0.04 : 0.18;
      }

      // Raycasting for post hover (only when not dragging)
      if (!dragMoved) {
        raycaster.setFromCamera(pointer, camera);
        const hitMeshes = postNodes.map(n => n.sphere);
        const hits = raycaster.intersectObjects(hitMeshes, false);
        const newHover = hits.length ? hits[0].object.userData.node : null;
        if (newHover !== hovered) {
          hovered = newHover;
          if (hovered) {
            renderer.domElement.style.cursor = 'pointer';
            tooltip.innerHTML =
              `<strong>${hovered.post.title}</strong>` +
              `<span class="tt-cat">${pretty(hovered.cluster.raw)}</span>` +
              `<em>${hovered.post.pubDate}</em>` +
              `<span class="tt-hint">Click to read →</span>`;
            tooltip.classList.add('visible');
          } else {
            renderer.domElement.style.cursor = isDragging ? 'grabbing' : 'grab';
            tooltip.classList.remove('visible');
          }
        }
        if (hovered) {
          const rect = renderer.domElement.getBoundingClientRect();
          const tx = (pointer.x * 0.5 + 0.5) * rect.width + rect.left;
          const ty = (-pointer.y * 0.5 + 0.5) * rect.height + rect.top;
          // Clamp inside viewport horizontally
          const maxL = window.innerWidth - 340;
          tooltip.style.left = Math.min(Math.max(8, tx + 14), maxL) + 'px';
          tooltip.style.top  = (ty + 16) + 'px';
        }
      }

      updateCamera();
      renderer.render(scene, camera);

      // === Project cluster labels into 3D space ===
      const rect = stageRect();
      const labelDivs = labels.querySelectorAll('.constellation-label');
      for (let i = 0; i < labelDivs.length; i++) {
        const C = clusters[i];
        tmpV.copy(C.center).project(camera);
        const x = (tmpV.x * 0.5 + 0.5) * rect.width;
        const y = (-tmpV.y * 0.5 + 0.5) * rect.height;
        const d = labelDivs[i];
        d.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
        const inFront = tmpV.z < 1;
        const onScreen = inFront
          && tmpV.x > -1.05 && tmpV.x < 1.05
          && tmpV.y > -1.05 && tmpV.y < 1.05
          && camera.position.distanceTo(C.center) < 220;
        d.classList.toggle('is-visible', onScreen);
      }
    }

    renderer.domElement.style.cursor = 'grab';
    animate();

    // === 14. Cleanup on Astro view transition ===
    function cleanup() {
      cancelAnimationFrame(animId);
      renderer.domElement.removeEventListener('pointerdown', onPointerDown);
      renderer.domElement.removeEventListener('wheel', onWheel);
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup',   onPointerUp);
      window.removeEventListener('resize',      onResize);
      // Disconnect the component-scoped ResizeObserver so view transitions don't leak observers.
      if (ro) { ro.disconnect(); ro = null; }
      resetBtn?.removeEventListener('click', resetView);
      // enterBtn listener is `{ once: true }` so it self-removes; nothing to do here.
      renderer.dispose();
      farStars.geometry.dispose(); farStars.material.dispose();
      midStars.geometry.dispose(); midStars.material.dispose();
      dust.geometry.dispose();     dust.material.dispose();
      for (const C of clusters) {
        C.core.geometry.dispose();  C.core.material.dispose();
        C.halo.geometry.dispose();  C.halo.material.dispose();
        C.glow.geometry.dispose();  C.glow.material.dispose();
        C.moteGeo.dispose();
        C.motes.material.dispose();
      }
      for (const n of postNodes) {
        n.sphere.geometry.dispose(); n.sphere.material.dispose();
        n.halo.geometry.dispose();   n.halo.material.dispose();
      }
    }
    document.addEventListener('astro:before-swap', cleanup);
  });
</script>

